{
  "manifest_version": 3,
  "name": "小红书主页笔记导出",
  "version": "0.4.0",
  "description": "采集小红书用户主页公开展示的笔记卡片，使用浏览器鼠标输入抓取详情正文和封面链接，并导出 Excel。",
  "permissions": ["activeTab", "tabs", "scripting", "downloads", "storage", "debugger", "sidePanel"],
  "host_permissions": ["https://www.xiaohongshu.com/*", "https://open.feishu.cn/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开小红书博主采集面板",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.xiaohongshu.com/*"],
      "js": ["note-utils.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
